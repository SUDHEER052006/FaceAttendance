[Unit]
Description=Face Attendance - dashboard
Documentation=file://@ROOT@/README.md
After=network-online.target fa-recognizer.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
ExecStart=@ROOT@/.venv/bin/python -m uvicorn app.web:app \
    --host @HOST@ --port @PORT@ --workers 1 --log-level warning \
    --proxy-headers --timeout-keep-alive 20

CPUAffinity=2
CPUWeight=100

Restart=always
RestartSec=3
StartLimitBurst=0

# The dashboard never needs the camera, so it does not get those groups.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fa-web

[Install]
WantedBy=multi-user.target
